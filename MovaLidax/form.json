{
    "elements": [
        {
            "type": "ValidationTextBox",
            "name": "Email",
            "caption": "E-Mail (MOVAhome)"
        },
        {
            "type": "PasswordTextBox",
            "name": "Password",
            "caption": "Passwort"
        },
        {
            "type": "Select",
            "name": "Region",
            "caption": "Region",
            "options": [
                { "caption": "Europa (EU)", "value": "eu" },
                { "caption": "USA", "value": "us" },
                { "caption": "China", "value": "cn" },
                { "caption": "Russland", "value": "ru" },
                { "caption": "Singapur", "value": "sg" }
            ]
        },
        {
            "type": "Select",
            "name": "AccountType",
            "caption": "Konto-Typ",
            "options": [
                { "caption": "MOVA", "value": "mova" },
                { "caption": "Dreame", "value": "dreame" }
            ]
        },
        {
            "type": "ValidationTextBox",
            "name": "DeviceID",
            "caption": "Geräte-ID (optional – leer = erstes Gerät)"
        },
        {
            "type": "NumberSpinner",
            "name": "Interval",
            "caption": "Abrufintervall",
            "suffix": "Sekunden",
            "minimum": 15
        },
        {
            "type": "CheckBox",
            "name": "AllowControl",
            "caption": "Steuerung freischalten (bewegende Befehle: Mähen starten) – mit Vorsicht!"
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Jetzt abrufen",
            "onClick": "MOVA_Poll($id);"
        },
        {
            "type": "Label",
            "caption": "— Steuerung —"
        },
        {
            "type": "RowLayout",
            "items": [
                { "type": "Button", "caption": "Gesamtes Gebiet", "onClick": "MOVA_StartAll($id);" },
                { "type": "Button", "caption": "Begrenzung", "onClick": "MOVA_StartEdge($id);" },
                { "type": "Button", "caption": "Pause", "onClick": "MOVA_MowerPause($id);" },
                { "type": "Button", "caption": "Stop", "onClick": "MOVA_MowerStop($id);" },
                { "type": "Button", "caption": "Zur Station", "onClick": "MOVA_MowerDock($id);" }
            ]
        },
        {
            "type": "Button",
            "caption": "Karte / Zonen laden",
            "onClick": "MOVA_LoadMap($id);"
        },
        {
            "type": "Label",
            "caption": "Zonen-Mähen: nach 'Karte / Zonen laden' die Variable 'Mähzone' im Objektbaum/WebFront auf die gewünschte Zone setzen. 'Gesamtes Gebiet' und 'Begrenzung' brauchen die Freischaltung oben."
        }
    ],
    "status": [
        { "code": 102, "icon": "active", "caption": "Aktiv" },
        { "code": 104, "icon": "inactive", "caption": "Bitte E-Mail und Passwort eintragen" },
        { "code": 200, "icon": "error", "caption": "Allgemeiner Fehler – siehe Log" },
        { "code": 201, "icon": "error", "caption": "Login fehlgeschlagen – Zugangsdaten/Region prüfen" },
        { "code": 202, "icon": "error", "caption": "Kein Gerät gefunden" },
        { "code": 203, "icon": "error", "caption": "Status nicht abrufbar (Gerät offline?)" }
    ]
}
