{
    "elements": [
        {
            "type": "ValidationTextBox",
            "name": "Email",
            "caption": "E-Mail (MOVAhome)"
        },
        {
            "type": "PasswordTextBox",
            "name": "Password",
            "caption": "Passwort"
        },
        {
            "type": "Select",
            "name": "Region",
            "caption": "Region",
            "options": [
                { "caption": "Europa (EU)", "value": "eu" },
                { "caption": "USA", "value": "us" },
                { "caption": "China", "value": "cn" },
                { "caption": "Russland", "value": "ru" },
                { "caption": "Singapur", "value": "sg" }
            ]
        },
        {
            "type": "Select",
            "name": "AccountType",
            "caption": "Konto-Typ",
            "options": [
                { "caption": "MOVA", "value": "mova" },
                { "caption": "Dreame", "value": "dreame" }
            ]
        },
        {
            "type": "ValidationTextBox",
            "name": "DeviceID",
            "caption": "Geräte-ID (optional – leer = erstes Gerät)"
        },
        {
            "type": "NumberSpinner",
            "name": "Interval",
            "caption": "Abrufintervall",
            "suffix": "Sekunden",
            "minimum": 15
        },
        {
            "type": "CheckBox",
            "name": "AllowControl",
            "caption": "Steuerung freischalten (bewegende Befehle: Mähen starten) – mit Vorsicht!"
        },
        {
            "type": "CheckBox",
            "name": "MapTransparent",
            "caption": "Kartenhintergrund transparent (passt sich der View an)"
        },
        {
            "type": "SelectColor",
            "name": "MapBackground",
            "caption": "Hintergrundfarbe (nur falls nicht transparent)"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Zonennamen (überschreiben App/Cloud-Namen)",
            "items": [
                {
                    "type": "Label",
                    "caption": "Die in der MOVA-App vergebenen Zonennamen liefert die Cloud nicht – sie kommt nur mit den Geräte-Standardnamen (Zone1…N). Hier eigene Namen vergeben; sie überschreiben die Cloud-Namen in Dropdown, Karte und Dashboard. Nach 'Karte / Zonen laden' erscheinen die gefundenen Zonen automatisch in der Liste. Name leer = Cloud-Name verwenden. Nach dem Ändern einmal 'Karte / Zonen laden' klicken."
                },
                {
                    "type": "List",
                    "name": "ZoneNames",
                    "caption": "Zonennamen",
                    "rowCount": 6,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Zonen-ID",
                            "name": "ZoneID",
                            "width": "120px",
                            "add": 0,
                            "edit": { "type": "NumberSpinner" }
                        },
                        {
                            "caption": "Name",
                            "name": "Name",
                            "width": "auto",
                            "add": "",
                            "edit": { "type": "ValidationTextBox" }
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Dashboard: Steuer-Buttons (Reihenfolge & Sichtbarkeit)",
            "items": [
                {
                    "type": "Label",
                    "caption": "Reihenfolge der Buttons = Reihenfolge in der Liste. 'Anzeigen' abwählen blendet einen Button aus, 'Beschriftung' leer = Standardname. Zum Umsortieren eine Zeile löschen und unten neu hinzufügen."
                },
                {
                    "type": "List",
                    "name": "ControlButtons",
                    "caption": "Steuer-Buttons",
                    "rowCount": 8,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Aktion",
                            "name": "Key",
                            "width": "200px",
                            "add": "all",
                            "edit": {
                                "type": "Select",
                                "options": [
                                    { "caption": "Gesamtes Gebiet", "value": "all" },
                                    { "caption": "Begrenzung", "value": "edge" },
                                    { "caption": "Pause", "value": "pause" },
                                    { "caption": "Stop", "value": "stop" },
                                    { "caption": "Andocken", "value": "dock" },
                                    { "caption": "Stopp & Heim", "value": "home" }
                                ]
                            }
                        },
                        {
                            "caption": "Beschriftung (optional)",
                            "name": "Label",
                            "width": "auto",
                            "add": "",
                            "edit": { "type": "ValidationTextBox" }
                        },
                        {
                            "caption": "Anzeigen",
                            "name": "Show",
                            "width": "90px",
                            "add": true,
                            "edit": { "type": "CheckBox" }
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Karten-Darstellung (Größe & Schrift)",
            "items": [
                {
                    "type": "Select",
                    "name": "DashboardLayout",
                    "caption": "Dashboard-Layout (HTML-Seite)",
                    "options": [
                        { "caption": "Geteilt: Steuerung links, Zonen rechts (für Tablet)", "value": "split" },
                        { "caption": "Steuerung rechts neben der Karte", "value": "right" },
                        { "caption": "Steuerung unter der Karte", "value": "bottom" }
                    ]
                },
                {
                    "type": "NumberSpinner",
                    "name": "MapMaxHeight",
                    "caption": "Max. Höhe der Karte",
                    "suffix": "% der Ansicht",
                    "minimum": 20,
                    "maximum": 100
                },
                {
                    "type": "NumberSpinner",
                    "name": "LabelSize",
                    "caption": "Zonen-Schriftgröße",
                    "minimum": 8,
                    "maximum": 80
                },
                {
                    "type": "NumberSpinner",
                    "name": "LegendSize",
                    "caption": "Legenden-Schriftgröße",
                    "minimum": 8,
                    "maximum": 60
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Jetzt abrufen",
            "onClick": "MOVA_Poll($id);"
        },
        {
            "type": "Label",
            "caption": "— Steuerung —"
        },
        {
            "type": "RowLayout",
            "items": [
                { "type": "Button", "caption": "Gesamtes Gebiet", "onClick": "MOVA_StartAll($id);" },
                { "type": "Button", "caption": "Begrenzung", "onClick": "MOVA_StartEdge($id);" },
                { "type": "Button", "caption": "Pause", "onClick": "MOVA_MowerPause($id);" },
                { "type": "Button", "caption": "Stop", "onClick": "MOVA_MowerStop($id);" },
                { "type": "Button", "caption": "Andocken", "onClick": "MOVA_MowerDock($id);" },
                { "type": "Button", "caption": "Stopp & Heim", "onClick": "MOVA_ReturnHome($id);" }
            ]
        },
        {
            "type": "Button",
            "caption": "Gewählte Zone mähen (aus 'Mähzone')",
            "onClick": "MOVA_StartSelectedZone($id);"
        },
        {
            "type": "RowLayout",
            "items": [
                { "type": "Button", "caption": "+ Zone zur Reihenfolge", "onClick": "MOVA_QueueAdd($id);" },
                { "type": "Button", "caption": "Reihenfolge mähen", "onClick": "MOVA_QueueRun($id);" },
                { "type": "Button", "caption": "Reihenfolge leeren", "onClick": "MOVA_QueueClear($id);" }
            ]
        },
        {
            "type": "Button",
            "caption": "Karte / Zonen laden",
            "onClick": "MOVA_LoadMap($id);"
        },
        {
            "type": "Label",
            "caption": "Zonen-Mähen: nach 'Karte / Zonen laden' die Variable 'Mähzone' im Objektbaum/WebFront auf die gewünschte Zone setzen. 'Gesamtes Gebiet' und 'Begrenzung' brauchen die Freischaltung oben."
        }
    ],
    "status": [
        { "code": 102, "icon": "active", "caption": "Aktiv" },
        { "code": 104, "icon": "inactive", "caption": "Bitte E-Mail und Passwort eintragen" },
        { "code": 200, "icon": "error", "caption": "Allgemeiner Fehler – siehe Log" },
        { "code": 201, "icon": "error", "caption": "Login fehlgeschlagen – Zugangsdaten/Region prüfen" },
        { "code": 202, "icon": "error", "caption": "Kein Gerät gefunden" },
        { "code": 203, "icon": "error", "caption": "Status nicht abrufbar (Gerät offline?)" }
    ]
}
